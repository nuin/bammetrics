{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nuin/bammetrics/blob/main/docs/schema/tools-1.json",
  "title": "bammetrics.tools/1",
  "description": "The listing of tools, options, exit codes and version: bammetrics tools --format json. Built from the option tables the verbs, --help and the Python stub use. Frozen: until 1.0.0 the schema changes only by adding members (docs/formats.md, Frozen schemas).",
  "type": "object",
  "required": ["schema", "bammetrics", "exit_codes", "tools", "verbs"],
  "properties": {
    "schema": {"const": "bammetrics.tools/1"},
    "bammetrics": {
      "type": "object",
      "required": ["name", "version", "commit", "features", "schemas"],
      "properties": {
        "name": {"const": "bammetrics"},
        "version": {"type": "string"},
        "commit": {"description": "The short commit of the build; null for a build with no git.", "type": ["string", "null"]},
        "features": {"description": "The cargo features compiled in: parquet, pdf.", "type": "array", "items": {"enum": ["parquet", "pdf"]}},
        "schemas": {"description": "The schemas the binary writes.", "type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "exit_codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "meaning"],
        "properties": {
          "code": {"type": "integer", "minimum": 0},
          "meaning": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "verbs": {"type": "array", "items": {"$ref": "#/$defs/verb"}}
  },
  "additionalProperties": false,
  "$defs": {
    "tool": {
      "description": "One tool verb and the Picard class it runs.",
      "type": "object",
      "required": ["verb", "class", "summary", "input", "reads_stdin", "files", "writes", "extensions", "chain_role", "options"],
      "properties": {
        "verb": {"type": "string"},
        "class": {"type": "string"},
        "summary": {"type": "string"},
        "input": {"description": "What the input is: BAM, VCF, FASTA, ...", "type": "string"},
        "reads_stdin": {"description": "False for a tool that reads its input twice: a wrapper must stage a file.", "type": "boolean"},
        "files": {"enum": ["single", "prefix", "bam"]},
        "writes": {"type": "string"},
        "extensions": {"description": "The extensions after an output prefix; empty when the tool has no prefix naming.", "type": "array", "items": {"type": "string"}},
        "chain_role": {"enum": ["transform", "tap", "split", "materialize", "none"]},
        "options": {"type": "array", "items": {"$ref": "#/$defs/tool_option"}}
      },
      "additionalProperties": false
    },
    "tool_option": {
      "description": "One row of a tool's option table.",
      "type": "object",
      "required": ["names", "flag", "short", "type", "kind", "repeated", "required", "written", "help"],
      "properties": {
        "names": {"description": "The Picard names, long name first.", "type": "array", "items": {"type": "string"}},
        "flag": {"description": "The verb flag; null for a rejected option.", "type": ["string", "null"]},
        "short": {"type": ["string", "null"]},
        "type": {"enum": ["bool", "int", "float", "text", "path"]},
        "kind": {"enum": ["value", "output", "ignored", "rejected"]},
        "repeated": {"type": "boolean"},
        "required": {"type": "boolean"},
        "written": {"type": "boolean"},
        "help": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verb": {
      "description": "A verb that is not a tool verb.",
      "type": "object",
      "required": ["name", "about", "options"],
      "properties": {
        "name": {"type": "string"},
        "about": {"type": "string"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/verb_option"}}
      },
      "additionalProperties": false
    },
    "verb_option": {
      "type": "object",
      "required": ["flag", "short", "takes_value", "repeated", "required", "help"],
      "properties": {
        "flag": {"type": "string"},
        "short": {"type": ["string", "null"]},
        "takes_value": {"type": "boolean"},
        "repeated": {"type": "boolean"},
        "required": {"type": "boolean"},
        "help": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
