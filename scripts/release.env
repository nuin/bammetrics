# Pinned inputs of scripts/release.sh. Sourceable shell assignments.
# Image digests are the multi-arch index digests (linux/amd64 and linux/arm64);
# centos:7 exists for linux/amd64 only.
RUST_ALPINE_IMAGE="rust:1.100-alpine@sha256:8d0e82abfdf9a38071e07cabc5afba4ddbe077631a80e4e742a760c38beadc33"
RUST_GLIBC_IMAGE="rust:1.100-bookworm@sha256:75d26c23c24cc6ea1cdabf0714a6bff8fd7bf3248716043fd7ae86dac7f41b94"
RUNNER_IMAGE="alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f"
CENTOS_IMAGE="centos:7@sha256:be65f488b7764ad3638f236b7b515b3678369a5124c47b8d32916d6487418ea4"
# Build tools installed into the docker volume bammetrics-cargo-tools.
CARGO_AUDITABLE_VERSION="0.7.8"
CARGO_CYCLONEDX_VERSION="0.5.10"
MAC_TOOLCHAIN="1.100.0"
MACOSX_DEPLOYMENT_TARGET="11.0"
# Targets whose gate failed; release.sh skips them and builds the rest.
BLOCKED_TARGETS=""
